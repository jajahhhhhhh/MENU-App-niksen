GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# Opn Payments (opn.ooo). Leave blank and the shop keeps its own free
# PromptPay QR with manual confirmation — nothing below is required to run.
# Secret key stays on the server only; the public key is sent to browsers.
OPN_SECRET_KEY=
OPN_PUBLIC_KEY=
# Point at a stub when testing. Defaults to https://api.omise.co
OPN_API_BASE=
